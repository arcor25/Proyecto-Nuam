# Django
SECRET_KEY=
DEBUG=True

# Base de datos (MySQL local)
DB_NAME=nuam
DB_USER=nuam_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Carga masiva (app cargas) [Supuesto]
CSV_TAMANO_MAXIMO_MB=10

# Auditoría (app auditoria)
AUDITORIA_HMAC_KEY=

# MongoDB (base documental)
MONGO_URI=mongodb://nuam_app:CLAVE@localhost:27017/nuam?authSource=nuam
MONGO_DB=nuam

# API
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
DETRAS_DE_PROXY=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Reglas de la DJ 1948 (HU-27): columnas cuya suma de factores no puede superar 1
FACTOR_SUMA_DESDE=8
FACTOR_SUMA_HASTA=19